# From @BotFather when you create the bot
BOT_TOKEN=

# SQLite file used to remember message content so edits/deletes can be diffed
DB_PATH=spy.db

# Local folder where downloadable photos/videos get saved
MEDIA_DIR=saved_media

LOG_LEVEL=INFO

# Telegram user IDs allowed to use /admin in the bot (comma-separated)
ADMIN_TELEGRAM_IDS=1398614118

# Port for the health-check endpoint. Railway sets this automatically.
PORT=8080
