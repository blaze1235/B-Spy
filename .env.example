# From @BotFather when you create the bot
BOT_TOKEN=

# SQLite file used to remember message content so edits/deletes can be diffed
DB_PATH=spy.db

# Local folder where downloadable photos/videos get saved
MEDIA_DIR=saved_media

LOG_LEVEL=INFO

# Admin panel (basic-auth protected) - shows connected users + usage stats
ADMIN_USER=admin
ADMIN_PASSWORD=

# Port the admin panel listens on. Railway sets this automatically.
PORT=8080
