# Get these from https://my.telegram.org -> API Development Tools
API_ID=
API_HASH=

# Generate with: python login.py
SESSION_STRING=

# Where notifications + saved media get sent. "me" = your Saved Messages.
# You can also use a channel/group id (e.g. -1001234567890) if you'd rather
# keep this out of your main Saved Messages.
NOTIFY_CHAT=me

# Local folder where self-destructing photos/videos are stored
MEDIA_DIR=saved_media

# SQLite db used to remember message content so edits/deletes can be diffed
DB_PATH=spy.db

LOG_LEVEL=INFO
